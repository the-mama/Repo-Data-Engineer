{
  "name": "MobilityMaster",
  "properties": {
    "concurrency": 1,
    "parameters": {
      "database_prefix": {
        "type": "String",
        "defaultValue": "mobility_dev"
      },
      "storage": {
        "type": "String",
        "defaultValue": "dltmmobilitydev"
      },
      "force": {
        "type": "Bool",
        "defaultValue": false
      }
    },
    "activities": [
      {
        "name": "ReadControl",
        "type": "Lookup",
        "dependsOn": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ControlConfig",
            "type": "DatasetReference",
            "parameters": {
              "database_prefix": {
                "value": "@pipeline().parameters.database_prefix",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        }
      },
      {
        "name": "PlanSources",
        "type": "SynapseNotebook",
        "dependsOn": [
          {
            "activity": "ReadControl",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        },
        "typeProperties": {
          "notebook": {
            "referenceName": "mobility_control_plan",
            "type": "NotebookReference"
          },
          "sparkPool": {
            "referenceName": "mobilityspark",
            "type": "BigDataPoolReference"
          },
          "parameters": {
            "database_prefix": {
              "value": {
                "value": "@pipeline().parameters.database_prefix",
                "type": "Expression"
              },
              "type": "string"
            },
            "storage": {
              "value": {
                "value": "@pipeline().parameters.storage",
                "type": "Expression"
              },
              "type": "string"
            },
            "config_json": {
              "value": {
                "value": "@string(activity('ReadControl').output.value)",
                "type": "Expression"
              },
              "type": "string"
            },
            "force": {
              "value": {
                "value": "@pipeline().parameters.force",
                "type": "Expression"
              },
              "type": "bool"
            }
          }
        }
      },
      {
        "name": "IngestActiveSources",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "PlanSources",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@json(activity('PlanSources').output.status.Output.result.exitValue).sources",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "RunSource",
              "type": "ExecutePipeline",
              "dependsOn": [],
              "typeProperties": {
                "pipeline": {
                  "referenceName": "IngestSource",
                  "type": "PipelineReference"
                },
                "waitOnCompletion": true,
                "parameters": {
                  "config": {
                    "value": "@item()",
                    "type": "Expression"
                  },
                  "batch_id": {
                    "value": "@pipeline().RunId",
                    "type": "Expression"
                  },
                  "database_prefix": {
                    "value": "@pipeline().parameters.database_prefix",
                    "type": "Expression"
                  },
                  "storage": {
                    "value": "@pipeline().parameters.storage",
                    "type": "Expression"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "BuildGold",
        "type": "SynapseNotebook",
        "dependsOn": [
          {
            "activity": "IngestActiveSources",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebook": {
            "referenceName": "mobility_gold",
            "type": "NotebookReference"
          },
          "sparkPool": {
            "referenceName": "mobilityspark",
            "type": "BigDataPoolReference"
          },
          "parameters": {
            "database_prefix": {
              "value": {
                "value": "@pipeline().parameters.database_prefix",
                "type": "Expression"
              },
              "type": "string"
            },
            "storage": {
              "value": {
                "value": "@pipeline().parameters.storage",
                "type": "Expression"
              },
              "type": "string"
            }
          },
          "snapshot": true
        },
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        }
      },
      {
        "name": "CheckFreshness",
        "type": "SynapseNotebook",
        "dependsOn": [
          {
            "activity": "BuildGold",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebook": {
            "referenceName": "mobility_health",
            "type": "NotebookReference"
          },
          "sparkPool": {
            "referenceName": "mobilityspark",
            "type": "BigDataPoolReference"
          },
          "parameters": {
            "database_prefix": {
              "value": {
                "value": "@pipeline().parameters.database_prefix",
                "type": "Expression"
              },
              "type": "string"
            },
            "max_age_minutes": {
              "value": "30",
              "type": "int"
            },
            "max_quarantine_pct": {
              "value": "5",
              "type": "int"
            },
            "check_mode": {
              "value": "freshness",
              "type": "string"
            }
          },
          "snapshot": true
        },
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        }
      },
      {
        "name": "CheckQuality",
        "type": "SynapseNotebook",
        "dependsOn": [
          {
            "activity": "CheckFreshness",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebook": {
            "referenceName": "mobility_health",
            "type": "NotebookReference"
          },
          "sparkPool": {
            "referenceName": "mobilityspark",
            "type": "BigDataPoolReference"
          },
          "parameters": {
            "database_prefix": {
              "value": {
                "value": "@pipeline().parameters.database_prefix",
                "type": "Expression"
              },
              "type": "string"
            },
            "max_age_minutes": {
              "value": "30",
              "type": "int"
            },
            "max_quarantine_pct": {
              "value": "5",
              "type": "int"
            },
            "check_mode": {
              "value": "quality",
              "type": "string"
            }
          },
          "snapshot": true
        },
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        }
      }
    ]
  }
}
